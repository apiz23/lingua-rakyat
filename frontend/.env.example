# Copy to .env.local and use keys from the SAME Clerk development instance.
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_replace_with_development_publishable_key
CLERK_SECRET_KEY=sk_test_replace_with_development_secret_key

# Local FastAPI origin. Keep this empty only when using a same-origin proxy.
NEXT_PUBLIC_API_URL=http://localhost:8000
